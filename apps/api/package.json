{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.mjs",
    "types": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "check-types": "tsc6 -p tsconfig.json --noEmit",

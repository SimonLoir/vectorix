        "start": "node dist/index.mjs",
        "lint": "eslint",
        "test": "tsx --test ../../packages/auth/tests/passkey-options.test.ts ../../packages/auth/tests/two-factor.test.ts src/template.test.ts",
        "test:integration": "tsx --test --test-concurrency=1 src/integration.test.ts src/rag.integration.test.ts"
    },
    "dependencies": {
        "@dotenvx/dotenvx": "^2.30.0",
        "@hono/node-server": "^2.1.1",
        "@orpc/contract": "^1.15.3",
        "@orpc/openapi": "^1.15.3",
        "@orpc/server": "^1.15.3",
        "@orpc/zod": "^1.15.3",
        "@repo/api": "workspace:*",
        "@repo/api-contracts": "workspace:*",
        "@repo/auth": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/queues": "workspace:*",
        "@routers/utils": "workspace:*",
        "hono": "^4.13.8",
        "pino": "^10.3.1",
        "zod": "^4.6.5",
        "bullmq": "^5.81.5",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "pg": "^8.23.0",
        "@better-auth/api-key": "1.6.33",
        "@better-auth/passkey": "1.6.33",
        "better-auth": "1.6.33",
        "nodemailer": "^10.0.10",
        "react": "19.3.0",
        "resend": "^6.28.1",
        "@orpc/client": "^1.15.3",
        "@routers/rag": "workspace:*",
        "@aws-sdk/client-s3": "3.1148.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.6.2",
        "@types/pg": "^8.23.1",
        "eslint": "^10.11.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "^8.3.0"

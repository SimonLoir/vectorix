# Local development only; generate independent secrets before deployment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vectorix
# Vector storage is independent of the application catalog and Prisma migrations.
# These passwords bootstrap NEW local vector volumes; changing them does not rotate existing roles.
VECTOR_POSTGRES_PASSWORD=vectorix-local-admin
VECTOR_PROVISIONER_PASSWORD=vectorix-local-indexer
VECTOR_RUNTIME_PASSWORD=vectorix-local-runtime
VECTOR_DATABASE_URL=postgresql://vectorix_runtime:vectorix-local-runtime@localhost:5433/vectorix_vectors
VECTOR_DATABASE_PROVISIONING_URL=postgresql://vectorix_indexer:vectorix-local-indexer@localhost:5433/vectorix_vectors
VECTOR_DATABASE_SCHEMA=vector_collections
# Platform S3 fallback; local Compose uses the same keys to initialize RustFS.
VECTORIX_DEFAULT_S3_ENDPOINT=http://localhost:9000
VECTORIX_DEFAULT_S3_REGION=us-east-1
VECTORIX_DEFAULT_S3_BUCKET=vectorix-documents
VECTORIX_DEFAULT_S3_ACCESS_KEY_ID=vectorix-local
VECTORIX_DEFAULT_S3_SECRET_ACCESS_KEY=vectorix-local-s3-secret
VECTORIX_DEFAULT_S3_FORCE_PATH_STYLE=true
# Comma-separated exact S3 endpoints allowed for organization credentials.
# The platform endpoint above is allowed automatically. Set on both API and workers.
# Invalid entries are ignored individually with a variable/index-only server warning.
VECTORIX_S3_ALLOWED_ENDPOINTS=
# Optional embedding fallback. Configure a complete provider here or select
# organization credentials through the dashboard or API. Native Ollama, Cohere,
# Voyage, OpenAI and Mistral indexing are supported.
VECTORIX_DEFAULT_OLLAMA_ENDPOINT=
VECTORIX_DEFAULT_OLLAMA_API_KEY=
# Exact organization embedding destinations approved by the operator (API and workers).
# Each supported provider's platform endpoint is approved only for that provider.
# Invalid entries are ignored individually; later valid entries remain available.
VECTORIX_EMBEDDING_ALLOWED_ENDPOINTS=
# Separate exact root-URL allowlist for optional native reranking; provider defaults also qualify.
VECTORIX_RERANKING_ALLOWED_ENDPOINTS=
# Optional native self-hosted TEI fallback (root URL). An empty API key sends no Authorization header.
# TEI is not an embedding provider. Organization reranking endpoints take precedence.
VECTORIX_DEFAULT_TEI_ENDPOINT=
VECTORIX_DEFAULT_TEI_API_KEY=
# Optional standalone TEI Compose profile loopback port.
VECTORIX_TEI_PORT=8081
# Technical organization limits; optional profiles and every search remain off by default.
VECTORIX_DEFAULT_RAG_RERANK_REQUESTS_PER_DAY=500
VECTORIX_DEFAULT_RAG_RERANK_PREPARED_BYTES_PER_DAY=268435456
VECTORIX_DEFAULT_RAG_RERANK_CONCURRENT_REQUESTS=4
# Provider root only: the adapter calls /v1/models and /v2/embed.
VECTORIX_DEFAULT_COHERE_ENDPOINT=https://api.cohere.com
VECTORIX_DEFAULT_COHERE_API_KEY=
# Provider root only: the adapter calls /v1/embeddings. Model listing is local.
VECTORIX_DEFAULT_VOYAGE_ENDPOINT=https://api.voyageai.com
VECTORIX_DEFAULT_VOYAGE_API_KEY=
# Complete API base, including /v1 (also retain an approved proxy path prefix).
VECTORIX_DEFAULT_OPENAI_ENDPOINT=https://api.openai.com/v1
VECTORIX_DEFAULT_OPENAI_API_KEY=
# Complete API base, including /v1; native fixed-dimension text embeddings.
VECTORIX_DEFAULT_MISTRAL_ENDPOINT=https://api.mistral.ai/v1
VECTORIX_DEFAULT_MISTRAL_API_KEY=
# Default organization quotas (overridable through the superadmin quota API).
VECTORIX_DEFAULT_RAG_COLLECTIONS=20
VECTORIX_DEFAULT_RAG_DOCUMENTS=5000
VECTORIX_DEFAULT_RAG_ORIGINAL_BYTES=26214400
VECTORIX_DEFAULT_RAG_STORAGE_BYTES=10737418240
VECTORIX_DEFAULT_RAG_CHUNKS_PER_COLLECTION=100000
VECTORIX_DEFAULT_RAG_TEMPORARY_CHUNKS_PER_COLLECTION=100000
# Semantic indexing: technical capacity/work limits, not monetary credits.
VECTORIX_DEFAULT_RAG_SEMANTIC_UNITS_PER_DOCUMENT=8192
VECTORIX_DEFAULT_RAG_SEMANTIC_PLAN_BYTES_PER_DOCUMENT=1048576
VECTORIX_DEFAULT_RAG_SEMANTIC_PLAN_BYTES_PER_ORGANIZATION=67108864
VECTORIX_DEFAULT_RAG_EMBEDDING_PREPARED_BYTES_PER_CANDIDATE=134217728
VECTORIX_DEFAULT_RAG_EMBEDDING_BATCHES_PER_CANDIDATE=4096
VECTORIX_DEFAULT_RAG_EMBEDDING_OUTSTANDING_PREPARED_BYTES=536870912
VECTORIX_DEFAULT_RAG_EMBEDDING_OUTSTANDING_BATCHES=16384
# Percent-encode URL username/password components once (for example @ becomes %40).
REDIS_URL=redis://localhost:6379
# Optional raw password fallback when REDIS_URL has no non-empty password.
REDIS_PASSWORD=
API_URL=http://localhost:3001
# Runtime timezone for web/admin providers; invalid or empty values use Europe/Brussels.
# Locale still follows the user preference. Restart consumers after changing it.
VECTORIX_TIME_ZONE=Europe/Brussels
BETTER_AUTH_URL=http://localhost:3001
# Required canonical base for password-reset and email-verification links; never inferred from request headers.
# Explicit HTTP(S), optional served path prefix, no credentials/query/fragment.
VECTORIX_WEB_URL=http://localhost:3000
# Exact HTTP(S) origins, without paths/query/fragments/wildcards. Explicit blank/invalid config fails startup.
# Shared CORS and cookie-RPC/REST CSRF allowlist. Include the API origin to permit Scalar cookie mutations.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3006
# Per-minute v1 API request budgets: integers 0..1000000; only 0 disables a bucket.
# Personal admission precedes permissions; provider-operation admission follows resource guards.
# These are request budgets, not native usage or billing. See docs/api-rate-limiting.md.
VECTORIX_API_RATE_LIMIT_PER_MINUTE=600
VECTORIX_API_PROVIDER_RATE_LIMIT_PER_MINUTE=60
VECTORIX_API_ORGANIZATION_PROVIDER_RATE_LIMIT_PER_MINUTE=300
# IP addresses or CIDR ranges of reverse proxies that connect to the API. Only then is
# X-Forwarded-For read (right to left, past trusted hops) for auth rate limits and sessions.
# Leave empty when clients connect directly. Invalid entries fail API startup.
# Auth counters share Redis; during an outage the bounded fallback is per API process.
# Canonical address/path rate keys are hashed; do not add raw keys or URLs to diagnostics.
VECTORIX_TRUSTED_PROXIES=
# API and workers refuse to start in production while these placeholders remain (pnpm setup:env replaces them).
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_SECRET=replace-with-64-random-hex-characters
# Up to 16 comma-separated retired 64-hex keys (4096 characters total), kept only for rotation reads (see docs/encryption-key-rotation.md).
ENCRYPTION_PREVIOUS_SECRETS=
# Optional shared session-cookie domain; leave empty on localhost. Every sibling must be trusted.
# SameSite cookies do not protect against an untrusted sibling origin; keep TRUSTED_ORIGINS narrow.
ROOT_DOMAIN=
# Optional cookie name/prefix overrides for hosting multiple apps.
BETTER_AUTH_COOKIE_NAME=
BETTER_AUTH_COOKIE_PREFIX=
ALLOW_ACCOUNT_CREATION=true
ALLOW_ORGANIZATION_CREATION=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Vectorix
PASSKEY_ORIGINS=http://localhost:3000,http://localhost:3006

# Platform account-security and notification mail: configured Resend key, otherwise SMTP.
# SMTP port is an integer 1..65535 (default 587); supply both auth values or neither.
# Only the selected provider sender is used; secrets are raw, never URL-encoded.
VECTORIX_DEFAULT_RESEND_API_KEY=
VECTORIX_DEFAULT_RESEND_SENDER_EMAIL=noreply@example.com
VECTORIX_DEFAULT_SMTP_HOST=
VECTORIX_DEFAULT_SMTP_PORT=587
VECTORIX_DEFAULT_SMTP_USER=
VECTORIX_DEFAULT_SMTP_PASSWORD=
VECTORIX_DEFAULT_SMTP_SENDER_EMAIL=noreply@example.com

# Optional external licensing provider. Failures/expired grants deny features.
VECTORIX_FEATURE_PROVIDER_URL=
VECTORIX_FEATURE_PROVIDER_TOKEN=
VECTORIX_FEATURE_PROVIDER_TIMEOUT_MS=3000
VECTORIX_FEATURE_PROVIDER_CACHE_TTL_MS=60000

# Optional web push; use the same public key on web, API and workers.
VECTORIX_WEB_PUSH_ENABLED=false
# Unset uses native Google/Mozilla/Microsoft/Apple push namespaces. Supplying
# this variable REPLACES them with exact HTTPS origins on port 443. Empty or
# malformed values disable admission. Custom destinations must resolve publicly.
# VECTORIX_WEB_PUSH_ALLOWED_ORIGINS=https://push.example.com
VECTORIX_VAPID_SUBJECT=mailto:admin@example.com
VECTORIX_VAPID_PUBLIC_KEY=
VECTORIX_VAPID_PRIVATE_KEY=

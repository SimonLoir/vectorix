# Local development only; generate independent secrets before deployment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vectorix
# Vector storage is independent of the application catalog and Prisma migrations.
# These passwords bootstrap NEW local vector volumes; changing them does not rotate existing roles.
VECTOR_POSTGRES_PASSWORD=vectorix-local-admin
VECTOR_PROVISIONER_PASSWORD=vectorix-local-indexer
VECTOR_RUNTIME_PASSWORD=vectorix-local-runtime
VECTOR_DATABASE_URL=postgresql://vectorix_runtime:vectorix-local-runtime@localhost:5433/vectorix_vectors
VECTOR_DATABASE_PROVISIONING_URL=postgresql://vectorix_indexer:vectorix-local-indexer@localhost:5433/vectorix_vectors
VECTOR_DATABASE_SCHEMA=vector_collections
# Platform S3 fallback; local Compose uses the same keys to initialize RustFS.
VECTORIX_DEFAULT_S3_ENDPOINT=http://localhost:9000
VECTORIX_DEFAULT_S3_REGION=us-east-1
VECTORIX_DEFAULT_S3_BUCKET=vectorix-documents
VECTORIX_DEFAULT_S3_ACCESS_KEY_ID=vectorix-local
VECTORIX_DEFAULT_S3_SECRET_ACCESS_KEY=vectorix-local-s3-secret
VECTORIX_DEFAULT_S3_FORCE_PATH_STYLE=true
# Comma-separated exact S3 endpoints allowed for organization credentials.
# The platform endpoint above is allowed automatically. Set on both API and workers.
VECTORIX_S3_ALLOWED_ENDPOINTS=
# Optional embedding fallback. Configure a complete provider here or select
# organization credentials through the dashboard or API. Native Ollama, Cohere
# and Voyage indexing are supported; OpenAI/Mistral execution remains planned.
VECTORIX_DEFAULT_OLLAMA_ENDPOINT=
VECTORIX_DEFAULT_OLLAMA_API_KEY=
# Exact organization embedding destinations approved by the operator (API and workers).
# Each supported provider's platform endpoint is approved only for that provider.
VECTORIX_EMBEDDING_ALLOWED_ENDPOINTS=
# Provider root only: the adapter calls /v1/models and /v2/embed.
VECTORIX_DEFAULT_COHERE_ENDPOINT=https://api.cohere.com
VECTORIX_DEFAULT_COHERE_API_KEY=
# Provider root only: the adapter calls /v1/embeddings. Model listing is local.
VECTORIX_DEFAULT_VOYAGE_ENDPOINT=https://api.voyageai.com
VECTORIX_DEFAULT_VOYAGE_API_KEY=
VECTORIX_DEFAULT_OPENAI_ENDPOINT=https://api.openai.com/v1
VECTORIX_DEFAULT_OPENAI_API_KEY=
VECTORIX_DEFAULT_MISTRAL_ENDPOINT=https://api.mistral.ai/v1
VECTORIX_DEFAULT_MISTRAL_API_KEY=
# Default organization quotas (overridable through the superadmin quota API).
VECTORIX_DEFAULT_RAG_COLLECTIONS=20
VECTORIX_DEFAULT_RAG_DOCUMENTS=5000
VECTORIX_DEFAULT_RAG_ORIGINAL_BYTES=26214400
VECTORIX_DEFAULT_RAG_STORAGE_BYTES=10737418240
VECTORIX_DEFAULT_RAG_CHUNKS_PER_COLLECTION=100000
VECTORIX_DEFAULT_RAG_TEMPORARY_CHUNKS_PER_COLLECTION=100000
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:3001
# Runtime timezone used for dashboard dates; locale still follows the user preference.
VECTORIX_TIME_ZONE=Europe/Brussels
BETTER_AUTH_URL=http://localhost:3001
VECTORIX_WEB_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3006
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_SECRET=replace-with-64-random-hex-characters
# Set for sibling production subdomains; leave empty on localhost.
ROOT_DOMAIN=
# Optional cookie name/prefix overrides for hosting multiple apps.
BETTER_AUTH_COOKIE_NAME=
BETTER_AUTH_COOKIE_PREFIX=
ALLOW_ACCOUNT_CREATION=true
ALLOW_ORGANIZATION_CREATION=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Vectorix
PASSKEY_ORIGINS=http://localhost:3000,http://localhost:3006

# Optional outbound mail: Resend or SMTP.
VECTORIX_DEFAULT_RESEND_API_KEY=
VECTORIX_DEFAULT_RESEND_SENDER_EMAIL=noreply@example.com
VECTORIX_DEFAULT_SMTP_HOST=
VECTORIX_DEFAULT_SMTP_PORT=587
VECTORIX_DEFAULT_SMTP_USER=
VECTORIX_DEFAULT_SMTP_PASSWORD=
VECTORIX_DEFAULT_SMTP_SENDER_EMAIL=noreply@example.com

# Optional external licensing provider. Failures/expired grants deny features.
VECTORIX_FEATURE_PROVIDER_URL=
VECTORIX_FEATURE_PROVIDER_TOKEN=
VECTORIX_FEATURE_PROVIDER_TIMEOUT_MS=3000
VECTORIX_FEATURE_PROVIDER_CACHE_TTL_MS=60000

# Optional web push; use the same public key on web, API and workers.
VECTORIX_WEB_PUSH_ENABLED=false
VECTORIX_VAPID_SUBJECT=mailto:admin@example.com
VECTORIX_VAPID_PUBLIC_KEY=
VECTORIX_VAPID_PRIVATE_KEY=

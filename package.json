{
    "name": "vectorix",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "dotenvx run -f .env -- turbo run dev --env-mode=loose",
        "build": "turbo run build",
        "check-types": "turbo run check-types",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "test:coverage": "pnpm --filter api test:coverage",
        "db:generate": "pnpm --filter @repo/db generate",
        "db:push": "dotenvx run -f .env -- pnpm --filter @repo/db db:push",
        "db:migrate": "dotenvx run -f .env -- pnpm --filter @repo/db migrate:deploy",
        "admin:grant": "dotenvx run -f .env -- pnpm --filter api exec tsx src/scripts/grant-admin.ts",
        "format": "prettier --write .",
        "setup:env": "node scripts/setup-env.mjs",
        "test:docker": "bash scripts/test-docker.sh",
        "test:infra": "bash scripts/test-infrastructure.sh",
        "test:documents": "pnpm --filter workers exec node --import tsx ../../tests/documents/parser.test.mts",
        "test:rag-primitives": "pnpm --filter @repo/chunking test && pnpm --filter @repo/embeddings test",
        "test:catalog": "bash scripts/test-catalog.sh",
        "test:restore:guards": "bash scripts/test-restore-guards.sh",
        "test:quality:guards": "bash scripts/test-quality-guards.sh",
        "test:capacity:guards": "bash scripts/test-capacity-guards.sh",
        "test:interruption:guards": "bash scripts/test-interruption-guards.sh",
        "test:queues": "bash scripts/test-redis.sh"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^2.30.0",
        "turbo": "^2.11.3",
        "prettier": "^3.9.8",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    }
}

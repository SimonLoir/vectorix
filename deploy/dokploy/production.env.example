# Paste into Dokploy: Vectorix service, Environment tab. Generate every secret separately:
#   openssl rand -hex 32   (hex passwords need no URL encoding in connection strings)
VECTORIX_TAG=sha-1aebd954f0295fb2f64bb353137381cf06993ecc

POSTGRES_PASSWORD=
REDIS_PASSWORD=
VECTOR_POSTGRES_PASSWORD=
VECTOR_PROVISIONER_PASSWORD=
VECTOR_RUNTIME_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# At least 32 characters: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Exactly 64 hex characters: openssl rand -hex 32. Back it up off the server:
# encrypted organization credentials are unrecoverable without it.
ENCRYPTION_SECRET=

# Subnet of dokploy-network:
#   docker network inspect dokploy-network --format '{{(index .IPAM.Config 0).Subnet}}'
VECTORIX_TRUSTED_PROXIES=

# Set to false after creating the first account for an invitation-only instance.
ALLOW_ACCOUNT_CREATION=true
ALLOW_ORGANIZATION_CREATION=true

# Mail (required for password reset and email verification): Resend or SMTP.
MAIL_SENDER=noreply@vectorix.app
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Embeddings: at least one platform provider, or per-organization credentials in the dashboard.
VECTORIX_DEFAULT_OPENAI_API_KEY=
VECTORIX_DEFAULT_MISTRAL_API_KEY=
VECTORIX_DEFAULT_COHERE_API_KEY=
VECTORIX_DEFAULT_VOYAGE_API_KEY=
VECTORIX_DEFAULT_OLLAMA_ENDPOINT=
VECTORIX_DEFAULT_OLLAMA_API_KEY=
# Extra exact URLs approved for organization credentials (comma-separated).
VECTORIX_EMBEDDING_ALLOWED_ENDPOINTS=
VECTORIX_S3_ALLOWED_ENDPOINTS=

{
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "declaration": false,
        "declarationMap": false,
        "composite": false,
        "incremental": true,
        "tsBuildInfoFile": "dist/.tsbuildinfo"
    },
    "include": ["src"]
}

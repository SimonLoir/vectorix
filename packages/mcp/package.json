{
    "name": "@vectorix/mcp",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Read-only organization-scoped Vectorix MCP stdio server",
    "bin": {
        "vectorix-mcp": "dist/cli.mjs"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "build": "vite build",
        "start": "node dist/cli.mjs",
        "check-types": "tsc6 -p tsconfig.json --noEmit",
        "lint": "eslint",
        "test": "pnpm --filter @vectorix/client build && node --import tsx --test tests/*.test.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.4.0",
        "zod": "^4.6.5",
        "@orpc/client": "^1.16.1"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.4.0",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "^8.3.5",
        "@vectorix/client": "workspace:^"
    },
    "license": "Apache-2.0"
}

{
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "declaration": false,
        "declarationMap": false,
        "composite": false,
        "allowJs": true,
        "checkJs": true,
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "types": ["node", "react"]
    },
    "include": ["src"]
}

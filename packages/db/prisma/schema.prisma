generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "esm"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/schemas"
  config   = "prisma/zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
}
